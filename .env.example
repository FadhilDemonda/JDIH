JDIH_STORAGE=local
JDIH_DATA_DIR=.jdih
JDIH_DEMO=0
JDIH_ADMIN_NIK=
JDIH_ADMIN_NAME=
JDIH_ADMIN_PASSWORD=

# Isi pengaturan berikut saat memakai JDIH_STORAGE=google.
GOOGLE_SHEETS_ID=
GOOGLE_DRIVE_ROOT_ID=
# Isi salah satu: isi JSON Service Account (mentah atau base64) ATAU path file .json lokal.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Opsional di lokal (otomatis memakai cache memori & berkas lokal di JDIH_DATA_DIR); wajib diisi di Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
